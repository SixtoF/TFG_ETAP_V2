# ==============================================================================
# CONFIGURACION DE BASE DE DATOS (PostgreSQL)
# ==============================================================================

# OPCION A: Ejecucion DENTRO de Docker (API, Workers)
# El host es "postgres" porque es el nombre del servicio en docker-compose.yml
#DATABASE_URL=postgresql+psycopg2://postgres:Pruebas2026@postgres:5432/etap_final_db

# OPCION B: Ejecucion desde el PC LOCAL (Uso exclusivo de Alembic o Scripts locales)
# Descomenta esta linea si vas a ejecutar 'alembic upgrade head' desde tu terminal
DATABASE_URL=postgresql+psycopg2://postgres:Pruebas2026@localhost:5432/etap_final_db
# Y luego lanzas Alembic normal
#alembic revision --autogenerate -m "cambio_X"
#alembic upgrade head

# ==============================================================================
# CONFIGURACION DE REDIS Y CELERY
# ==============================================================================

# CONFIGURACION PARA DOCKER
# Los contenedores se comunican usando el nombre del servicio "redis"
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CONFIGURACION PARA LOCAL (Fuera de Docker)
# Solo si ejecutas el worker o la app directamente en tu Windows/Linux
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1